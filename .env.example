# ================================================================
# LearnSphere AI - environment template
# ================================================================
# Copy this file to `.env` before starting Docker Compose:
#   Copy-Item .env.example .env
#
# `.env` is git-ignored. Never commit real credentials. The values below are
# local-development placeholders only; replace every `change-me` value before
# any shared deployment.

# Spring profile. `demo` is the local-development profile: it uses the
# PostgreSQL settings below and seeds the documented demo personas. Use
# `local` for an empty development database, or `prod` for a deployment that
# must boot with no demo accounts (the deployment supplies its own datasource).
SPRING_PROFILES_ACTIVE=demo

# Password for the demo personas below. Required only when the `demo` profile
# is active. It is never printed by the reset script or written to the logs.
# Login validation requires 8-16 characters with an uppercase letter, a digit
# and a special character.
SEED_PASSWORD=DemoPass1!

# PostgreSQL. Both `MOOC` and `learnsphere_payments` live on this server; the
# init script creates the second database.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local-dev-only-change-me
POSTGRES_PORT=5432

# Host ports for the local stack.
BACKEND_PORT=8080
PAYMENTS_PORT=8081
FRONTEND_PORT=4200

# Backend secrets and endpoints.
JWT_SECRET=local-dev-only-jwt-secret-change-me-before-any-shared-deployment-0123456789
JWT_EXPIRATION_MS=900000
JWT_ISSUER=learnsphere
JWT_AUDIENCE=learnsphere-web
INTERNAL_API_KEY=local-dev-only-internal-key-change-me
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200
APP_UPLOAD_DIR=/app/uploads

# NVIDIA NIM (get a key from https://build.nvidia.com/). Leave the key empty to
# use the local fallback responses.
NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key_here
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=meta/llama-3.1-70b-instruct

# Razorpay test credentials. The payments service refuses to start without
# these variables; replace them with your own test keys before exercising a
# checkout. Never put live keys in this file.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=local-dev-only-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=local-dev-only-webhook-secret
MAIN_BACKEND_URL=http://backend:8080
