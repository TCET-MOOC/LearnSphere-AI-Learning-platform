{
  "name": "learnsphere",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "e2e": "playwright test --project=chromium",
    "e2e:ui": "playwright test --project=chromium --ui",
    "e2e:visual": "playwright test --project=visual",
    "e2e:visual:update": "playwright test --project=visual --update-snapshots",
    "lint:styles": "node scripts/stylelint-ratchet.mjs",
    "lint:styles:update": "node scripts/stylelint-ratchet.mjs --update"
  },
  "private": true,
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "@angular/animations": "^21.2.17",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@lucide/angular": "^1.31.0",
    "@stomp/stompjs": "^7.3.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide": "^1.31.0",
    "lucide-angular": "^1.0.0",
    "rxjs": "~7.8.0",
    "sockjs-client": "^1.6.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.16",
    "@angular/cli": "^21.2.16",
    "@angular/compiler-cli": "^21.2.0",
    "@playwright/test": "^1.64.1",
    "@types/sockjs-client": "^1.5.4",
    "jsdom": "^28.0.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.8.1",
    "stylelint": "^17.16.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
