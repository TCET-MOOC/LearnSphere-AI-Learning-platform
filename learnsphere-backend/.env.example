# ================================================================
# LearnSphere AI - Environment Variables Template
# ================================================================
# Copy this file to .env and insert your NVIDIA NIM API Key below:
# Location: c:\Users\singh\OneDrive\Desktop\LearnSphere-AI---An-Online-Learning-Platform\.env

# NVIDIA NIM API Key (Get from https://build.nvidia.com/)
NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key_here

# (Optional) NVIDIA NIM Base URL & Model Defaults
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=meta/llama-3.1-70b-instruct
